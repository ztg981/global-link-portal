# Global Link portal - server settings. Copy to .env.local for local dev;
# set the same names in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values (this repo is public).

# --- Shared with the globallink.com website (global-link-club) ---
# Same Neon database and same token secret, so website accounts work here.
DATABASE_URL=
AUTH_SECRET=
# Used in password-reset links and "Create your account" links.
SITE_URL=https://global-link-club.vercel.app

# --- Admin console (not a database account) ---
ADMIN_USERNAME=admin718
# scrypt hash(es), comma-separated: node scripts/hash-password.mjs "your password"
ADMIN_PASSWORD_HASH=
# Optional two-step sign-in: a base32 TOTP secret for an authenticator app.
ADMIN_TOTP_SECRET=
ADMIN_DISPLAY_NAME=Jordan Reyes

# --- Lumi and translation: provider waterfall ---
# Every Gemini key (comma-separated), Flash then Flash-Lite, then the secondary provider.
GEMINI_API_KEYS=
GEMINI_MODEL_SMART=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
SECONDARY_PROVIDER=openrouter
SECONDARY_API_KEY=
# Free OpenRouter models only unless ALLOW_PAID_MODELS=1
SECONDARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
LLM_TIMEOUT_MS=15000

# --- Optional services (each turns on when set) ---
# Google sign-in. Redirect URI: https://<this app>/api/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://global-link-club.vercel.app
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Global Link <onboarding@resend.dev>
# Card payments in the app (Stripe). Webhook URL: https://<this app>/api/stripe
STRIPE_SECRET_KEY=
# Shown to families who pay on WeChat (optional)
WECHAT_PAY_ID=
# Uploads (Vercel Blob; added automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=
# Scheduled jobs (/api/cron); same value as the GitHub secret CRON_SECRET
CRON_SECRET=
PAYOUT_USD_PER_LESSON=20
APP_URL=https://global-link-portal.vercel.app

IP_SALT=
ALLOWED_ORIGINS=

# Local dev only: keep the PGlite database between restarts.
PGLITE_DIR=.pglite
